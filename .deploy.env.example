# Configuration for ./deploy.sh. Copy to .deploy.env (gitignored) and fill in.
#
# All four are required. Branch defaults to "main", remote to "origin".

DEPLOY_HOST=ews.example.com
DEPLOY_USER=ews
DEPLOY_PATH=/srv/apocalypse-ews
DEPLOY_BRANCH=main
DEPLOY_REMOTE=origin

# Optional: SSH port if non-standard
# DEPLOY_SSH_PORT=22

# Optional: extra ssh flags (e.g. identity file)
# DEPLOY_SSH_OPTS="-i ~/.ssh/ews_deploy"
