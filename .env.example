# Discord application credentials. Get these from https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: gates the hidden /dev-fire command to a single user id for end-to-end testing.
DEV_ADMIN_USER_ID=

# Where the SQLite file lives. Defaults to ./data/ews.db
DATABASE_PATH=./data/ews.db

# RSS source. Override only for testing.
EWS_RSS_URL=https://ews.kylemcdonald.net/rss.xml

# Poll cadence (cron). Default is every 30 minutes, matching the feed's ttl.
POLL_CRON=*/30 * * * *

# Daily annual-reminder cron. Default 13:00 UTC.
REMINDER_CRON=0 13 * * *

# 'development' | 'test' | 'production'. Production switches pino to JSON
# output suitable for a log shipper or `journalctl` capture.
NODE_ENV=development

# Log level. Defaults to 'info' (or 'error' under NODE_ENV=test).
# Allowed: debug | info | warn | error
LOG_LEVEL=info

# Optional log file path. Defaults to ./data/ews.log. Set to "" to disable
# file output and only log to stdout.
# LOG_FILE=./data/ews.log
