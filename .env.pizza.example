# Pentagon Pizza Watch — a SECOND Discord application, separate from the EWS bot.
# Copy to .env.pizza (gitignored) and fill in. The two bots share this repo and
# its toolchain but nothing else: separate token, separate database, separate
# subscriber list.

# Discord application credentials. https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Xpoz API key — this is how the bot reads the source account's posts.
# Get one at https://xpoz.ai/get-token
XPOZ_API_KEY=

# Optional: override only to point at a non-default Xpoz deployment.
# XPOZ_SERVER_URL=https://mcp.xpoz.ai/mcp

# Optional: gates nothing today, but the operator DM falls back to it.
DEV_ADMIN_USER_ID=

# Optional: the bot DMs this user on install / subscribe / unsubscribe.
# Falls back to DEV_ADMIN_USER_ID if unset.
OPERATOR_USER_ID=

# Optional: if set, `bun run pizza:register-commands` registers slash commands
# guild-scoped so they appear instantly. Unset = global (~1h propagation).
TEST_GUILD_ID=

# Where the SQLite file lives. MUST differ from the EWS bot's path.
DATABASE_PATH=./data/pizza.db

# Source account. Override only for testing.
PIZZA_ACCOUNT=PenPizzaReport

# Posts pulled per tick. Needs headroom over the poll interval — the account
# posts in bursts of five or six within a few minutes.
PIZZA_FETCH_LIMIT=25

# Fan-out floor, 1..5. Transitions below this are recorded but not announced.
# 3 = announce ELEVATED and up. 1 = announce every change, including noise.
PIZZA_MIN_ALERT_LEVEL=3

# Poll cadence (cron). The source account posts irregularly; 15 min is a
# reasonable compromise between freshness and Xpoz credit burn.
POLL_CRON=*/15 * * * *

# 'development' | 'test' | 'production'. Production switches the logger to one
# JSON line per record.
NODE_ENV=development

# Log level. Defaults to 'info'. Allowed: debug | info | warn | error
LOG_LEVEL=info

# Optional log file path. Set to "" to disable file output.
LOG_FILE=./data/pizza.log
