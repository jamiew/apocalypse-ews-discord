# Discord application credentials. Get these from https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: Discord webhook for DEBUG/INFO (installs, uninstalls, routine status).
# Create it in Server Settings → Integrations → Webhooks. Treat the URL as a secret.
# Empty or unset disables this stream. Replaces OPERATOR_USER_ID / DEV_ADMIN_USER_ID.
INFO_WEBHOOK_URL=

# Optional: separate Discord webhook for WARN/ERROR, including urgent alerts.
# Use a channel you do not mute. Empty or unset disables this stream.
ERROR_WEBHOOK_URL=

# Optional: if set, `bun run register-commands` registers slash commands as
# guild-scoped to this guild only — they appear instantly. Unset or empty =
# global registration, which takes ~1 hour to propagate. Use this in dev.
# Right-click your test server → "Copy Server ID".
TEST_GUILD_ID=

# Where the SQLite file lives. Defaults to ./data/ews.db
DATABASE_PATH=./data/ews.db

# RSS source. Override only for testing.
EWS_RSS_URL=https://ews.kylemcdonald.net/rss.xml

# Dashboard source for emergency-level transitions.
EWS_DASHBOARD_URL=https://pub-49bb6a6f314c47be9b481c25e5f6ca9e.r2.dev/dashboard.json

# Poll cadence (cron). Default is every 30 minutes, matching the feed's ttl.
POLL_CRON=*/30 * * * *

# Daily annual-reminder cron. Default 13:00 UTC.
REMINDER_CRON=0 13 * * *

# Daily heartbeat check. Subscriber heartbeats retain their existing 6–10 day cadence.
HEARTBEAT_CRON=0 14 * * *

# 'development' | 'test' | 'production'. Production switches the logger to
# one JSON line per record, suitable for a log shipper or `journalctl` capture.
# 'test' silences stdout (errors only) and skips the file sink entirely.
NODE_ENV=development

# Local log level. Webhook routing receives all severities independently.
# Defaults to 'info' ('error' in tests). Allowed: debug | info | warn | error
LOG_LEVEL=info

# Optional log file path. Defaults to ./data/ews.log. Set to "" to disable
# file output and only log to stdout.
# LOG_FILE=./data/ews.log
