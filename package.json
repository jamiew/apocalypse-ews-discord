{
	"name": "apocalypse-ews-bot",
	"version": "0.1.0",
	"private": true,
	"description": "Apocalypse EWS // Discord bot. Tracked-aircraft anomalies, rolling 24h. Level 5 → announced. Otherwise silent.",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"dev": "bun --watch run src/index.ts",
		"start": "bun run src/index.ts",
		"register-commands": "bun run src/scripts/register-commands.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"test": "bun test src",
		"ci": "biome ci . && tsc --noEmit && bun test src"
	},
	"engines": {
		"bun": ">=1.2"
	},
	"dependencies": {
		"discord.js": "^14.26.4",
		"node-cron": "^4.2.1",
		"rss-parser": "^3.13.0",
		"zod": "^4.4.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.14",
		"@types/bun": "^1.2.0",
		"typescript": "^6.0.3"
	}
}
