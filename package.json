{
	"name": "apocalypse-ews-bot",
	"version": "0.1.0",
	"private": true,
	"description": "Apocalypse EWS // Discord bot. Tracked-aircraft anomalies, rolling 24h. Level 5 → announced. Otherwise silent.",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"dev": "tsx watch --env-file-if-exists=.env src/index.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/index.js",
		"register-commands": "tsx --env-file-if-exists=.env src/scripts/register-commands.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"test": "vitest run",
		"ci": "biome ci . && tsc --noEmit && vitest run && tsc -p tsconfig.build.json"
	},
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"better-sqlite3": "^12.9.0",
		"discord.js": "^14.26.4",
		"node-cron": "^4.2.1",
		"rss-parser": "^3.13.0",
		"zod": "^4.4.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.13",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^25.6.0",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.10",
		"vitest": "^4.1.5"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"better-sqlite3"
		]
	}
}
