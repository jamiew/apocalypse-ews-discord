[Unit]
Description=Apocalypse EWS Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ews
WorkingDirectory=/opt/apocalypse-ews
EnvironmentFile=/opt/apocalypse-ews/.env
ExecStart=/usr/bin/node /opt/apocalypse-ews/dist/index.js
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/apocalypse-ews/data

[Install]
WantedBy=multi-user.target
